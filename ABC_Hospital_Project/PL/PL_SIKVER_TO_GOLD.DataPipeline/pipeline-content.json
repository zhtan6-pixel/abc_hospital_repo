                      "type": "Expression"
                    },
                    "type": "Query"
                  }
                ],
                "scriptBlockExecutionTimeout": "02:00:00"
              },
              "linkedService": {
                "name": "WH_Hospital_Project",
                "properties": {
                  "type": "DataWarehouse",
                  "typeProperties": {
                    "artifactId": "a98f074c-0bf8-86c1-4638-28638ff51d2b",

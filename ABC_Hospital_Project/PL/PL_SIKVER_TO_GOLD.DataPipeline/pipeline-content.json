                    "workspaceId": "00000000-0000-0000-0000-000000000000"
                  },
                  "annotations": []
                }
              },
              "policy": {
                "timeout": "0.12:00:00",
                "retry": 0,
                "retryIntervalInSeconds": 30,
                "secureInput": false,
                "secureOutput": false
              },
              "name": "Insert In Progress Status",
              "dependsOn": []
            },
            {
              "type": "Script",
              "typeProperties": {
                "scripts": [
                  {
                    "text": {
                      "value": "@concat(\n'UPDATE [ctrl].[audit_log]\nSET [status] = ''SUCCESS'',\n    [end_time] = SYSUTCDATETIME(),\n    [records_written] = ',\nvariables('row_count'),\n'\nWHERE [adf_run_id] = ''',\npipeline().parameters.run_id,\n'''\nAND [table_id] = ',\nstring(item().table_id)\n)",
                      "type": "Expression"
                    },
                    "type": "Query"
                  }
                ],

{
	"name": "PL_SEND_EMAIL",
	"properties": {
		"activities": [
			{
				"name": "Read All Tables Status",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "SELECT * FROM [ctrl].[audit_log] \nwhere adf_run_id = '@{pipeline().parameters.run_id}'",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "AzureSqlTable1",
						"type": "DatasetReference"
					}
				}
			},
			{
				"name": "Prepare Email Body Header",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "body_header",
					"value": "Ingestion  Transformation process for ABC Hospital Project has been completed and below is the status:"
				}
			},
			{
				"name": "Prepare Email Body Footer",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "body_footer",
					"value": "For any support, please reach out to it@gmail.com"
				}
			},
			{
				"name": "Prepare Email Subject",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Check overall failed count",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "email_subject",
					"value": {
						"value": "@{pipeline().globalParameters.env} | @{if(greater(activity('Check overall failed count').output.firstRow.count , 0), '', '')} | ABC HOSPITAL MASTER RUN",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Check overall failed count",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "SELECT COUNT(*) as count FROM [ctrl].[audit_log] \nwhere adf_run_id = '@{pipeline().parameters.run_id}'\nand status != 'SUCCESS'",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "AzureSqlTable1",
						"type": "DatasetReference"
					}
				}
			},
			{
				"name": "Prepare Logic Apps Body",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Prepare Email Subject",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Prepare Email Body Footer",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Prepare Email Body Header",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Read All Tables Status",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "logic_apps_body",
					"value": {
						"value": "activity('Read All Tables Status').output{\n\"subject\":\"@{variables('email_subject')}\",\n\"email receipients\":\"@{pipeline().globalParameters.email_recipient}\",\n\"body_header\":\"@{variables('body_header')}\",\n\"body_footer\":\"@{variables('body_footer')}\",\n\"status_table\":@{activity('Read All Tables Status').output.value}\n}",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"run_id": {
				"type": "string",
				"defaultValue": "05239560-8b63-4f41-b4bd-ef0066ccbd4e"
			}
		},
		"variables": {
			"body_header": {
				"type": "String"
			},
			"email_subject": {
				"type": "String"
			},
			"logic_apps_body": {
				"type": "String"
			},
			"body_footer": {
				"type": "String"
			}
		},
		"annotations": []
	}
}
			}
		],
		"parameters": {
			"run_id": {
				"type": "string",
				"defaultValue": "05239560-8b63-4f41-b4bd-ef0066ccbd4e"
			}
		},
		"variables": {
			"body_header": {
				"type": "String"
			}
		},
		"annotations": []
	}
}
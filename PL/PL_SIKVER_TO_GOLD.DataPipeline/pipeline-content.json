              "typeProperties": {
                "scripts": [
                  {
                    "text": {
                      "value": "insert into [ctrl].[audit_log] (\n--[audit_id]\n      [adf_run_id]\n      ,[table_id]\n      ,[stage]\n      ,[status]\n      --,[records_written]\n      ,[start_time]\n      --,[end_time]\n      --,[created_timestamp]\n)\nvalues(\n      '@{pipeline().parameters.run_id}',\n       @{item().table_id},\n       'SILVER_TO_GOLD',\n       'IN_PROGRESS',\n       SYSUTCDATETIME()\n)",
                      "type": "Expression"
                    },
                    "type": "Query"
                  }
                ],
                "scriptBlockExecutionTimeout": "02:00:00"
              },
              "linkedService": {
                "name": "WH_Hospital_Project",
                "properties": {
                  "type": "DataWarehouse",
                  "typeProperties": {
                    "artifactId": "a98f074c-0bf8-86c1-4638-28638ff51d2b",
                    "endpoint": "on5oue4otmdeldszoxpe6wtpta-hl6m6bsupjoejodsviljomnup4.datawarehouse.fabric.microsoft.com",
                    "workspaceId": "00000000-0000-0000-0000-000000000000"
                  },
                  "annotations": []
                }
              },
              "policy": {
                "timeout": "0.12:00:00",
                "retry": 0,
                "retryIntervalInSeconds": 30,
                "secureInput": false,
                "secureOutput": false
              },
              "name": "Insert In Progress Status",
              "dependsOn": []
            },
            {
              "type": "Script",
              "typeProperties": {
                "scripts": [
                  {
                    "text": {
                      "value": "update [ctrl].[audit_log] \nset [status] = 'SUCCESS', \n    [end_time] = SYSUTCDATETIME(), \n    [records_written] = @{activity('Silver to Gold').output.result.exitValue} \nwhere [adf_run_id] = '@{pipeline().parameters.run_id}' \nand [table_id] = @{item().table_id}",
                      "type": "Expression"
                    },
                    "type": "Query"
                  }
                ],
                "scriptBlockExecutionTimeout": "02:00:00"
              },
              "linkedService": {
                "name": "WH_Hospital_Project",
                "properties": {
                  "type": "DataWarehouse",
                  "typeProperties": {
                    "artifactId": "a98f074c-0bf8-86c1-4638-28638ff51d2b",
                    "endpoint": "on5oue4otmdeldszoxpe6wtpta-hl6m6bsupjoejodsviljomnup4.datawarehouse.fabric.microsoft.com",
                    "workspaceId": "00000000-0000-0000-0000-000000000000"
                  },
                  "annotations": []
                }
              },
              "policy": {
                "timeout": "0.12:00:00",
                "retry": 0,
                "retryIntervalInSeconds": 30,
                "secureInput": false,
                "secureOutput": false
              },
              "name": "Update Success Status",
              "dependsOn": [
                {
                  "activity": "Silver to Gold",
                  "dependencyConditions": [
                    "Succeeded"
                  ]
                }
              ]
            },
            {
              "type": "Script",
              "typeProperties": {
                "scripts": [
                  {
                    "text": {
                      "value": "update [ctrl].[audit_log] \nset [status] = 'Failed', [end_time] = SYSUTCDATETIME()\nwhere [adf_run_id] = '@{pipeline().parameters.run_id}' and [table_id] = @{item().table_id}",
                      "type": "Expression"
                    },
                    "type": "Query"
                  }
                ],
                "scriptBlockExecutionTimeout": "02:00:00"
              },
